{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.ashwinjames.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ashwinjames.com"
        }
      ],
      "destination": "https://www.ashwinjames.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/performance-marketing-specialist",
      "destination": "/services/performance-marketing-services",
      "permanent": true
    },
    {
      "source": "/services/hubspot",
      "destination": "/services/hubspot-crm-integration",
      "permanent": true
    },
    {
      "source": "/blog/performance-marketing-specialist",
      "destination": "/blog/performance-marketing-specialist-in-dubai",
      "permanent": true
    },
    {
      "source": "/services/performance-marketing",
      "destination": "/services/performance-marketing-services",
      "permanent": true
    },
    {
      "source": "/services/performance-growth-marketing",
      "destination": "/services/performance-marketing-services",
      "permanent": true
    },
    {
      "source": "/services/hubspot-crm-automation",
      "destination": "/services/hubspot-crm-integration",
      "permanent": true
    },
    {
      "source": "/services/landing-page-optimisation",
      "destination": "/services/cro",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
